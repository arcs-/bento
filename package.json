{
  "name": "bento",
  "version": "0.0.0",
  "description": "Resizable panels as web components",
  "license": "MIT",
  "keywords": [
    "web-components",
    "resizable",
    "panels",
    "splitter",
    "layout"
  ],
  "type": "module",
  "sideEffects": true,
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/bento.d.ts",
      "default": "./dist/bento.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "vite build",
    "test": "vitest",
    "lint": "oxlint",
    "format": "oxfmt",
    "typecheck": "tsc --noEmit",
    "check": "oxlint && oxfmt --check && tsc --noEmit && vitest --run"
  },
  "devDependencies": {
    "@vitest/browser-playwright": "5.0.2",
    "oxfmt": "0.70.0",
    "oxlint": "1.85.0",
    "playwright": "1.63.0",
    "typescript": "7.0.2",
    "vite": "8.3.1",
    "vitest": "5.0.2"
  },
  "packageManager": "pnpm@12.6.0"
}
